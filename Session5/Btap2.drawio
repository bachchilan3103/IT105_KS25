alue="Hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="d" target="charge" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="invalid" target="e" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="charge" target="fork" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="fork" target="success" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="fork" target="email" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="success" target="join" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="email" target="join" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" source="join" target="e" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n1" value="Quy tắc 1: Chỉ gọi API trừ tiền SAU KHI mã QR đã được xác minh hợp lệ." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="150" y="1050" width="420" height="70" as="geometry" /></mxCell><mxCell id="n2" value="Quy tắc 2: Sau khi trừ tiền thành công, thực hiện song song:&lt;br&gt;• Hiển thị thành công ngay trên App&lt;br&gt;• Gửi email chạy ngầm" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="590" y="1035" width="390" height="105" as="geometry" /></mxCell><mxCell id="n3" value="Edge case: QR hết hạn (&gt; 15 phút) → xác minh không hợp lệ → báo lỗi, không trừ tiền và kết thúc." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="150" y="1150" width="830" height="80" as="geometry" /></mxCell><mxCell id="analysis" value="&lt;b&gt;PHÂN TÍCH 2 LỖI AS-IS&lt;/b&gt;&lt;br&gt;1. SAI THỨ TỰ AN TOÀN: Gọi API trừ tiền trước khi xác minh QR → có nguy cơ trừ tiền với mã không hợp lệ.&lt;br&gt;2. SAI LOGIC XỬ LÝ THÀNH CÔNG: Sau khi QR hợp lệ, cần trừ tiền rồi mới phản hồi thành công; hiển thị thành công và gửi email phải chạy song song, không để email làm chậm phản hồi App." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#6c8ebf;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1260" width="830" height="130" as="geometry" /></mxCell></root></mxGraphModel>