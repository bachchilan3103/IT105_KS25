relative="1" as="geometry" /></mxCell><mxCell id="include" value="«include»" style="dashed=1;html=1;endArrow=open;endFill=0;strokeWidth=1.5;rounded=0;" parent="1" edge="1" source="order" target="cart"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="extend" value="«extend»" style="dashed=1;html=1;endArrow=open;endFill=0;strokeWidth=1.5;rounded=0;" parent="1" edge="1" source="voucher" target="order"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note1" value="Bắt buộc: Đặt hàng luôn phải Kiểm tra giỏ hàng." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1"><mxGeometry x="205" y="585" width="290" height="65" as="geometry" /></mxCell><mxCell id="note2" value="Tùy chọn: Có voucher thì khách hàng có thể Áp dụng mã giảm giá. Voucher hết hạn vẫn cho phép đặt hàng giá gốc." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1"><mxGeometry x="515" y="585" width="400" height="80" as="geometry" /></mxCell><mxCell id="analysis" value="PHÂN TÍCH LỖI AS-IS&lt;br&gt;1. Đặt hàng «extend» Kiểm tra giỏ hàng → SAI: kiểm tra giỏ hàng là bắt buộc nên phải dùng «include».&lt;br&gt;2. Áp dụng mã giảm giá «include» Đặt hàng → SAI: áp dụng mã là tùy chọn nên phải dùng «extend», và mũi tên «extend» hướng về Đặt hàng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#6c8ebf;spacing=8;" parent="1"><mxGeometry x="180" y="690" width="760" height="125" as="geometry" /></mxCell></root></mxGraphModel>